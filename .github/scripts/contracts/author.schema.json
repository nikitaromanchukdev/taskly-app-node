{
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "units"],
  "properties": {
    "summary": { "type": "string", "maxLength": 3000 },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "unit", "verdict", "expectations", "attempts"],
        "properties": {
          "path": { "type": "string", "maxLength": 300 },
          "unit": {
            "type": "string",
            "description": "The Unit's name only: an identifier or dotted identifier (createApp, TodoRepository.stats, default, useTodosQuery), or a route as METHOD and path (GET /api/todos/due-soon). Nothing after it: no notes, no words like route or handler.",
            "maxLength": 200,
            "pattern": "^([A-Za-z_$][\\w$]*(\\.[A-Za-z_$][\\w$]*)*|(GET|POST|PUT|PATCH|DELETE) /\\S*)$"
          },
          "verdict": { "type": "string", "enum": ["added", "amended", "not-needed", "flagged-defect"] },
          "reason": {
            "type": "string",
            "description": "Required when verdict is not-needed.",
            "enum": ["already-covered", "no-logic", "trivial", "not-unit-testable", "unreachable"]
          },
          "expectations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["text", "source", "kind", "tests"],
              "properties": {
                "text": { "type": "string", "maxLength": 500 },
                "source": { "type": "string", "maxLength": 300 },
                "kind": {
                  "type": "string",
                  "description": "characterization when no Intent source states the behaviour, else intent. A characterization test's name starts with \"characterization: \".",
                  "enum": ["intent", "characterization"]
                },
                "tests": {
                  "type": "array",
                  "description": "The tests that check this Expectation, as <path from the repo root> > <test name>. A test checks one Expectation.",
                  "items": { "type": "string", "maxLength": 300, "pattern": "^(backend|frontend)/[^ >]+\\.test\\.tsx? > .+" }
                }
              }
            }
          },
          "attempts": { "type": "integer" },
          "defect": {
            "type": "object",
            "description": "Required when verdict is flagged-defect.",
            "additionalProperties": false,
            "required": ["test", "expected", "received", "source"],
            "properties": {
              "test": { "type": "string", "maxLength": 300, "pattern": "^(backend|frontend)/[^ >]+\\.test\\.tsx? > .+", "description": "<path from the repo root> > <describe> > <test name>, e.g. backend/tests/sort.test.ts > sortForTriage > orders by priority." },
              "expected": { "type": "string", "maxLength": 500 },
              "received": { "type": "string", "maxLength": 500 },
              "source": { "type": "string", "maxLength": 300 }
            }
          }
        }
      }
    }
  }
}
