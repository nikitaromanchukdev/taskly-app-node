{
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "findings", "defects"],
  "properties": {
    "summary": { "type": "string", "maxLength": 3000 },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["test", "severity", "reason", "note"],
        "properties": {
          "test": { "type": "string", "maxLength": 300, "pattern": "^(backend|frontend)/[^ >]+\\.test\\.tsx? > .+", "description": "<path from the repo root> > <describe> > <test name>, e.g. backend/tests/sort.test.ts > sortForTriage > orders by priority." },
          "severity": { "type": "string", "enum": ["blocking", "advisory"] },
          "reason": {
            "type": "string",
            "enum": ["tautology", "unsupported-expectation", "tests-implementation", "flaky", "out-of-scope"]
          },
          "note": { "type": "string", "maxLength": 1000 }
        }
      }
    },
    "defects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "unit", "decision", "source_quote"],
        "properties": {
          "path": { "type": "string", "maxLength": 300 },
          "unit": {
            "type": "string",
            "description": "The Unit's name only: an identifier or dotted identifier (createApp, TodoRepository.stats, default, useTodosQuery), or a route as METHOD and path (GET /api/todos/due-soon). Nothing after it: no notes, no words like route or handler.",
            "maxLength": 200,
            "pattern": "^([A-Za-z_$][\\w$]*(\\.[A-Za-z_$][\\w$]*)*|(GET|POST|PUT|PATCH|DELETE) /\\S*)$"
          },
          "decision": { "type": "string", "enum": ["confirmed", "rejected"] },
          "source_quote": { "type": "string", "maxLength": 1000 }
        }
      }
    }
  }
}
