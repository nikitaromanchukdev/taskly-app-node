+import { describe, expect, it } from 'vitest';
+import { truncate } from '../src/core/truncate.ts';
+
+describe('truncate', () => {
+  it('returns text of exactly max characters unchanged', () => {
+    expect(truncate('abcde', 5)).toBe('abcde');
+  });
+
+  it('cuts longer text to max characters, ending with an ellipsis', () => {
+    expect(truncate('abcdef', 5)).toBe('abcd…');
+  });
+
+  it('throws a RangeError when max is below 1', () => {
+    expect(() => truncate('a', 0)).toThrow(RangeError);
+  });
+});
