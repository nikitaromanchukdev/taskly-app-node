+import { describe, expect, it, vi } from 'vitest';
+
+describe('truncate limits', () => {
+  it('keeps short text', () => {
+    const truncate = vi.fn((text: string, _max: number) => text);
+    expect(truncate('abc', 5)).toBe('abc');
+  });
+});
