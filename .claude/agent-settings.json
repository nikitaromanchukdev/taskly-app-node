{
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Edit",
      "Write",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git status:*)",
      "Bash(.github/scripts/agent/sandbox.sh test:*)",
      "Bash(.github/scripts/agent/sandbox.sh typecheck:*)"
    ],
    "deny": [
      "WebFetch",
      "WebSearch",
      "Bash(gh:*)",
      "Bash(git push:*)",
      "Bash(curl:*)",
      "Bash(wget:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.github/scripts/agent/guard.ts hook"
          }
        ]
      }
    ]
  }
}
